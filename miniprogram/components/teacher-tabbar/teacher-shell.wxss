.teacher-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #eef3fb;
  background-image:
    radial-gradient(circle 420rpx at 100% 0%, rgba(82, 183, 255, 0.12) 0%, transparent 60%),
    radial-gradient(circle 360rpx at 0% 4%, rgba(182, 166, 255, 0.10) 0%, transparent 55%),
    linear-gradient(rgba(11, 22, 51, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11, 22, 51, 0.025) 1px, transparent 1px);
  background-size: auto, auto, 44rpx 44rpx, 44rpx 44rpx;
}

.teacher-hero {
  margin: 24rpx 24rpx 8rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 22px;
  color: #fff;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 50%, #b6a6ff 100%);
  box-shadow: 0 10px 24px rgba(31, 91, 255, 0.30);
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  opacity: 0.72;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.86;
  line-height: 1.5;
}

.hero-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat:active {
  opacity: 0.72;
}

.hero-stat text {
  font-size: 36rpx;
  font-weight: 800;
}

.hero-stat label {
  margin-top: 8rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

.hero-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.35);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 28rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0b1633;
}

.section-note {
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.48);
}

.white-card {
  position: relative;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20px;
  border: 1px solid rgba(11, 22, 51, 0.06);
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
  overflow: hidden;
}

.white-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
}

.row-card {
  display: flex;
  align-items: center;
}

.primary-btn {
  display: block;
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999px;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  box-shadow: 0 10px 24px rgba(31, 91, 255, 0.30);
}

.primary-btn::after,
.ghost-btn::after {
  border: none !important;
}

.ghost-btn {
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  border: none;
  border-radius: 999px;
  color: #2459ff;
  font-size: 24rpx;
  font-weight: 700;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.30);
}

.danger-btn {
  display: block;
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  margin: 16rpx 0 0;
  padding: 0;
  border: none;
  border-radius: 999px;
  color: #e11d48;
  font-size: 28rpx;
  font-weight: 800;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx rgba(225, 29, 72, 0.28);
}

.danger-btn::after {
  border: none !important;
}

.empty-block {
  margin: 0 24rpx;
  padding: 64rpx 24rpx;
  text-align: center;
  color: rgba(11, 22, 51, 0.48);
  font-size: 26rpx;
}

.empty-block text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.38);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 24rpx 8rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999px;
  background: #fff;
  color: rgba(11, 22, 51, 0.62);
  font-size: 22rpx;
  font-weight: 700;
  border: 1px solid rgba(11, 22, 51, 0.06);
}

.chip.on {
  color: #fff;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  box-shadow: 0 6px 16px rgba(31, 91, 255, 0.28);
  border-color: transparent;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 12px;
  padding: 4px 12px 4px 10px;
  border-radius: 999px;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: none;
  color: #2459ff;
  background: rgba(36, 89, 255, 0.12);
}

.loading-line {
  padding: 80rpx 0;
  text-align: center;
  color: rgba(11, 22, 51, 0.45);
  font-size: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin: 8rpx 24rpx 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 999px;
  border: 1px solid rgba(11, 22, 51, 0.06);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-clear {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #2459ff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.date-cell {
  min-width: 220rpx;
  padding: 14rpx 22rpx;
  border-radius: 999px;
  background: #fff;
  color: #0b1633;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.22);
}

.date-sep {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(11, 22, 51, 0.45);
  flex-shrink: 0;
}

.more-btn {
  display: block;
  width: auto;
  margin: 24rpx 24rpx 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999px;
  font-size: 28rpx;
  font-weight: 700;
  color: #2459ff !important;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.30), 0 12px 36px rgba(11, 22, 51, 0.06);
}

.more-btn::after {
  border: none !important;
}
