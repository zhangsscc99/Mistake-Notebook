<view class="teacher-shell">
  <view class="teacher-hero">
    <view class="hero-kicker">PAPER</view>
    <view class="hero-title">帮孩子组卷</view>
    <view class="hero-sub">从孩子已解析完的错题里选题。生成后孩子在学生端也能看到这份卷。</view>
    <view class="hero-stats">
      <view class="hero-stat"><text>{{papers.length}}</text><label>试卷数</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat"><text>{{totalQuestionCount}}</text><label>总题数</label></view>
    </view>
  </view>

  <view class="chip-row" wx:if="{{children.length}}">
    <view class="picker-chip {{childId === item.studentId ? 'active' : ''}}" wx:for="{{children}}" wx:key="studentId" data-id="{{item.studentId}}" bindtap="selectChild">{{item.nickName}}</view>
  </view>

  <view class="create-section" wx:if="{{childId}}">
    <button class="create-btn" bindtap="createNewPaper">
      <text class="create-btn-text">＋ 组建新卷</text>
    </button>
  </view>

  <view class="section-head" wx:if="{{papers.length}}"><text class="section-title">{{childName || '孩子'}}的试卷</text></view>
  <view class="paper-card" wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" bindtap="openPaper">
    <view class="paper-left-accent"></view>
    <view class="paper-body">
      <view class="paper-header-row">
        <view class="paper-icon-circle"><text class="paper-icon-text">卷</text></view>
        <view class="paper-info">
          <text class="paper-title-text">{{item.title}}</text>
          <text class="paper-meta-text">{{item.questionCount}} 道题 · {{item.createdAt}}</text>
        </view>
        <text class="paper-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && childId && !papers.length}}">
    <text class="empty-title">还没有试卷</text>
    <text class="empty-desc-text">先帮孩子拍照录入错题，解析完成后再组卷</text>
    <button class="empty-action-btn" bindtap="createNewPaper">
      <text class="create-btn-text">立即组建新卷</text>
    </button>
  </view>
  <view class="empty-block" wx:if="{{!loading && !children.length}}">请先绑定孩子</view>
  <view class="loading-line" wx:if="{{loading}}">加载试卷…</view>
  <parent-tabbar active="paper"></parent-tabbar>
</view>
