.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 24rpx 8rpx;
}

.picker-chip {
  padding: 10rpx 22rpx;
  border-radius: 999px;
  background: #fff;
  color: rgba(11, 22, 51, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 2rpx rgba(11, 22, 51, 0.08);
}

.picker-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  box-shadow: 0 6px 16px rgba(31, 91, 255, 0.28);
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dist-row:first-child {
  margin-top: 0;
}

.dist-name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b1633;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dist-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999px;
  background: rgba(36, 89, 255, 0.12);
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(135deg, #2459ff, #52b7ff);
}

.dist-num {
  width: 56rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
}

.q-index {
  font-size: 22rpx;
  font-weight: 800;
  color: #2459ff;
}

.q-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #0b1633;
}

.q-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.img-link {
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
  flex-shrink: 0;
  white-space: nowrap;
}
