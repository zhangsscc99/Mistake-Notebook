.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 24rpx 8rpx;
}

.picker-chip {
  padding: 10rpx 22rpx;
  border-radius: 999px;
  background: #fff;
  color: rgba(11, 22, 51, 0.62);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 2rpx rgba(11, 22, 51, 0.08);
}

.picker-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  box-shadow: 0 6px 16px rgba(31, 91, 255, 0.28);
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dist-row:first-child {
  margin-top: 0;
}

.dist-name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b1633;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dist-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999px;
  background: rgba(36, 89, 255, 0.12);
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(135deg, #2459ff, #52b7ff);
}

.dist-num {
  width: 56rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
}

.q-index {
  font-size: 22rpx;
  font-weight: 800;
  color: #2459ff;
}

.q-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #0b1633;
}

.q-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.img-link {
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
  flex-shrink: 0;
  white-space: nowrap;
}

.tap-card:active {
  opacity: 0.92;
}

.q-arrow {
  margin-left: auto;
  font-size: 32rpx;
  color: rgba(11, 22, 51, 0.28);
}

.status-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999px;
}

.status-badge.pending {
  color: #2459ff;
  background: rgba(36, 89, 255, 0.12);
}

.status-badge.failed {
  color: #e11d48;
  background: rgba(225, 29, 72, 0.1);
}

.status-badge.ready {
  color: #0f9d58;
  background: rgba(15, 157, 88, 0.12);
}

.mini-bar {
  margin-top: 16rpx;
  height: 8rpx;
  border-radius: 999px;
  background: rgba(36, 89, 255, 0.12);
  overflow: hidden;
  position: relative;
}

.mini-bar-fill {
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2459ff, #52b7ff);
  animation: pendingShimmer 1.4s ease-in-out infinite;
}

.pending-card {
  margin: 8rpx 24rpx 16rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border: 1px solid rgba(36, 89, 255, 0.18);
  border-radius: 18px;
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.pending-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pending-card-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.pending-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2459ff;
}

.pending-card-count {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(11, 22, 51, 0.55);
}

.pending-indeterminate-bar {
  height: 10rpx;
  border-radius: 999px;
  background: rgba(36, 89, 255, 0.12);
  overflow: hidden;
  position: relative;
  margin-bottom: 12rpx;
}

.pending-indeterminate-fill {
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2459ff, #52b7ff);
  animation: pendingShimmer 1.4s ease-in-out infinite;
}

@keyframes pendingShimmer {
  0% { left: -40%; }
  100% { left: 100%; }
}

.pending-card-hint {
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.45);
  line-height: 1.5;
}

.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.detail-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 88%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16px;
  z-index: 201;
  overflow: hidden;
}

.detail-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border-bottom: 1px solid rgba(11, 22, 51, 0.08);
}

.detail-modal-title {
  font-size: 16px;
  font-weight: 600;
  color: #0b1633;
}

.detail-modal-close {
  font-size: 26px;
  line-height: 1;
  color: #aaa;
}

.detail-modal-body {
  flex: 1;
  height: 0;
  min-height: 200px;
  max-height: 58vh;
  padding: 16px 18px;
  box-sizing: border-box;
}

.detail-img {
  width: 100%;
  border-radius: 10px;
  margin-bottom: 14px;
}

.detail-section {
  margin-bottom: 16px;
}

.detail-section-title {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #2459ff;
  margin-bottom: 6px;
}

.detail-section-body {
  display: block;
  font-size: 14px;
  line-height: 1.7;
  color: #0b1633;
  white-space: pre-wrap;
  word-break: break-word;
}

.detail-section-ai {
  background: rgba(36, 89, 255, 0.04);
  border-radius: 10px;
  padding: 12px;
}

.detail-placeholder {
  color: #888;
  font-size: 13px;
}

.detail-modal-confirm {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 18px 18px !important;
  height: 80rpx !important;
  padding: 0 !important;
  line-height: 1 !important;
  background: #2459ff;
  color: #fff;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 700;
}

.detail-modal-confirm::after {
  border: none !important;
}

.retry-btn {
  margin: 0 !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 999px !important;
  background: rgba(225, 29, 72, 0.1) !important;
  color: #e11d48 !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
}

.retry-btn::after {
  border: none !important;
}
