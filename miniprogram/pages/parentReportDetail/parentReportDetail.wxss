.detail-page {
  padding-bottom: 48rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}

.date-cell {
  min-width: 220rpx;
  padding: 14rpx 22rpx;
  border-radius: 999px;
  background: #fff;
  color: #0b1633;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.22);
}

.date-sep {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(11, 22, 51, 0.45);
  flex-shrink: 0;
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dist-row:first-child {
  margin-top: 0;
}

.dist-name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #0b1633;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dist-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999px;
  background: rgba(36, 89, 255, 0.12);
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(135deg, #2459ff, #52b7ff);
}

.dist-num {
  width: 56rpx;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
}

.dist-fill.class {
  background: rgba(11, 22, 51, 0.28);
}

.q-index {
  font-size: 22rpx;
  font-weight: 800;
  color: #2459ff;
}

.q-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #0b1633;
}

.q-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.img-link {
  font-size: 22rpx;
  font-weight: 700;
  color: #2459ff;
  flex-shrink: 0;
  white-space: nowrap;
}

.class-meta {
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.5);
}

.class-compare {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2459ff;
}

.class-empty {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.45);
}

.more-btn {
  display: block;
  width: auto;
  margin: 24rpx 24rpx 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999px;
  font-size: 28rpx;
  font-weight: 700;
  color: #2459ff !important;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.30), 0 12px 36px rgba(11, 22, 51, 0.06);
}

.more-btn::after {
  border: none !important;
}
