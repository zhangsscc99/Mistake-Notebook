<view class="teacher-shell">
  <view class="teacher-hero">
    <view class="hero-kicker">PAPER</view>
    <view class="hero-title">班级组卷</view>
    <view class="hero-sub">从全班错题或老师拍照题库选题，再发给班级。题单草稿只老师能看见</view>
    <view class="hero-stats">
      <view class="hero-stat" data-key="papers" bindtap="jumpStat"><text>{{papers.length}}</text><label>题单</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" data-key="notebooks" bindtap="jumpStat"><text>{{notebooks.length}}</text><label>练习</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" data-key="assignments" bindtap="jumpStat"><text>{{assignments.length}}</text><label>作业</label></view>
    </view>
  </view>

  <view class="chip-row">
    <view class="chip {{selectedClass.id === item.id ? 'on' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view>
  </view>

  <view class="pick-banner" wx:if="{{pickCount}}">已选 {{pickCount}} 道题带到这里。点「发给班级」选练习或作业，或先存成题单草稿</view>

  <view class="action-grid">
    <view class="white-card" bindtap="goPick"><view class="paper-title">选题组卷</view><view class="paper-meta">学生错题或班级题库</view></view>
    <view class="white-card" bindtap="goCapture"><view class="paper-title">拍照录入</view><view class="paper-meta">拍试卷存进这个班的题库</view></view>
    <view class="white-card" bindtap="goSend"><view class="paper-title">发给班级</view><view class="paper-meta">练习给学生看题，作业需作答批改</view></view>
    <view class="white-card" bindtap="savePaper"><view class="paper-title">存为题单</view><view class="paper-meta">仅老师可见的草稿</view></view>
  </view>

  <view id="section-papers" class="section-head"><text class="section-title">题单草稿</text></view>
  <view class="white-card tap-card" wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" data-type="paper" bindtap="openSet">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · {{item.createdAt}} · 学生看不到</view>
  </view>
  <view class="empty-block" wx:if="{{!papers.length}}">还没有题单草稿<text>选题后点「存为题单」，之后可从草稿发给班级</text></view>

  <view id="section-notebooks" class="section-head"><text class="section-title">已发练习</text></view>
  <view class="white-card tap-card" wx:for="{{notebooks}}" wx:key="id" data-id="{{item.id}}" data-type="notebook" bindtap="openSet">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · {{item.createdAt}} · 学生在「我的班级」可见</view>
  </view>
  <view class="empty-block" wx:if="{{!notebooks.length}}">还没有发给班级的练习<text>选题后点「发给班级」，选练习即可</text></view>

  <view id="section-assignments" class="section-head"><text class="section-title">作业</text><text class="section-note" bindtap="openAssignments">全部批改 ›</text></view>
  <view class="white-card tap-card" wx:for="{{assignments}}" wx:key="_id" data-id="{{item._id}}" bindtap="openAssignment">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · 点开查看提交并批改</view>
  </view>
  <view class="empty-block" wx:if="{{!assignments.length}}">还没有作业<text>发给班级时选「作业」，学生作答后可在这里打分</text></view>

  <teacher-tabbar active="paper"></teacher-tabbar>
</view>
