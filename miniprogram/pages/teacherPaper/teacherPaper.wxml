<view class="teacher-shell">
  <view class="teacher-hero">
    <view class="hero-kicker">PAPER</view>
    <view class="hero-title">班级组卷</view>
    <view class="hero-sub">点上方数字查看试卷、错题本或作业。从全班错题选题后可保存、推送或布置</view>
    <view class="hero-stats">
      <view class="hero-stat" data-key="papers" bindtap="jumpStat"><text>{{papers.length}}</text><label>试卷</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" data-key="notebooks" bindtap="jumpStat"><text>{{notebooks.length}}</text><label>错题本</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" data-key="assignments" bindtap="jumpStat"><text>{{assignments.length}}</text><label>作业</label></view>
    </view>
  </view>

  <view class="chip-row">
    <view class="chip {{selectedClass.id === item.id ? 'on' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view>
  </view>

  <view class="pick-banner" wx:if="{{pickCount}}">已选 {{pickCount}} 道题带到这里。可保存试卷或推送错题本；布置作业请走作业页</view>

  <view class="action-grid">
    <view class="white-card" bindtap="goPick"><view class="paper-title">选题组卷</view><view class="paper-meta">打开全班错题勾选</view></view>
    <view class="white-card" bindtap="publishNotebook"><view class="paper-title">推送错题本</view><view class="paper-meta">发给全班练习</view></view>
    <view class="white-card" bindtap="createHomework"><view class="paper-title">布置作业</view><view class="paper-meta">打开发布页，可设截止时间</view></view>
    <view class="white-card" bindtap="savePaper"><view class="paper-title">保存试卷</view><view class="paper-meta">先存老师端题单</view></view>
  </view>

  <view id="section-papers" class="section-head"><text class="section-title">已保存试卷</text></view>
  <view class="white-card tap-card" wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" data-type="paper" bindtap="openSet">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · {{item.createdAt}} · 点开查看</view>
  </view>
  <view class="empty-block" wx:if="{{!papers.length}}">还没有班级试卷<text>从全班错题勾选后保存，点开可回看题目</text></view>

  <view id="section-notebooks" class="section-head"><text class="section-title">已推送错题本</text></view>
  <view class="white-card tap-card" wx:for="{{notebooks}}" wx:key="id" data-id="{{item.id}}" data-type="notebook" bindtap="openSet">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · {{item.createdAt}} · 学生可在「我的班级」看到</view>
  </view>
  <view class="empty-block" wx:if="{{!notebooks.length}}">还没有推送给班级的错题本<text>选题后点「推送错题本」，再点卡片可回看</text></view>

  <view id="section-assignments" class="section-head"><text class="section-title">已布置作业</text><text class="section-note" bindtap="openAssignments">全部批改 ›</text></view>
  <view class="white-card tap-card" wx:for="{{assignments}}" wx:key="_id" data-id="{{item._id}}" bindtap="openAssignment">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.questionCount}} 道题 · 点开查看提交并批改</view>
  </view>
  <view class="empty-block" wx:if="{{!assignments.length}}">还没有作业<text>请到作业页布置，和组卷分开</text></view>

  <teacher-tabbar active="paper"></teacher-tabbar>
</view>
