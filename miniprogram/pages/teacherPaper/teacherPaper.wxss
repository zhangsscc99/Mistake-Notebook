.paper-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0b1633;
}

.paper-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.5);
}

.cart-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.cart-index {
  flex-shrink: 0;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 8rpx;
  border-radius: 12rpx 4rpx 12rpx 4rpx;
  background: linear-gradient(140deg, #2459ff, #52b7ff);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
}

.cart-body {
  flex: 1;
  min-width: 0;
}

.q-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.cart-remove {
  flex-shrink: 0;
  margin-top: 4rpx;
  color: #e11d48;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.checkout-actions {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 24rpx 8rpx;
}

.checkout-actions .ghost-btn,
.checkout-actions .primary-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 8rpx 24rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2459ff;
}

.history-dates {
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.link-dot {
  color: rgba(11, 22, 51, 0.28);
}

.tap-card {
  padding-right: 48rpx;
}
