/* pages/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #eaf3ff;
  padding-bottom: 40rpx;
}

/* 顶部身份卡 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx 36rpx;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 50%, #b6a6ff 100%);
}

/* 头像：button 原生样式必须重置，否则会带一圈默认边框和灰底 */
.avatar-btn {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  border-radius: 50%;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.2);
  box-sizing: border-box;
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #2459ff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(11, 22, 51, 0.18);
}

.hero-name {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 30rpx;
}

.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 6rpx;
}

.stat-lab {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.35);
}

/* 分组 */
.section-group {
  margin: 24rpx 24rpx 0;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(11, 22, 51, 0.5);
  padding: 0 4rpx 12rpx;
  letter-spacing: 1rpx;
}

.section-hint {
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.4);
  padding: 12rpx 4rpx 0;
}

.cell-list {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(47, 107, 255, 0.1);
  border-radius: 20rpx;
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(11, 22, 51, 0.06);
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 28rpx;
  color: #0b1633;
  font-weight: 500;
}

.cell-value {
  font-size: 26rpx;
  color: rgba(11, 22, 51, 0.45);
}

.cell-arrow {
  font-size: 32rpx;
  color: rgba(11, 22, 51, 0.3);
  line-height: 1;
}

/* 昵称表单 */
.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx 8rpx;
}

.form-label {
  font-size: 28rpx;
  color: #0b1633;
  font-weight: 500;
  flex-shrink: 0;
}

.nick-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f1f4fb;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #0b1633;
  text-align: right;
}

.nick-placeholder {
  color: rgba(11, 22, 51, 0.32);
  font-size: 25rpx;
}

.form-actions {
  padding: 16rpx 28rpx 26rpx;
}

.save-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(31, 91, 255, 0.28);
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: rgba(36, 89, 255, 0.30);
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}
