<!--pages/login/login.wxml-->
<view class="login-page">
  <view class="hero">
    <view class="mark">错</view>
    <view class="title">智卷错题通</view>
    <view class="subtitle" wx:if="{{invited}}">同学推荐你来一起整理错题</view>
    <view class="subtitle" wx:elif="{{intentRole === 'teacher'}}">登录后进入班级工作台，查看学情</view>
    <view class="subtitle" wx:elif="{{intentRole === 'parent'}}">绑定孩子后，查看作业和学情</view>
    <view class="subtitle" wx:else>用微信身份进入，每人一份自己的错题本</view>
  </view>

  <view class="card" wx:if="{{checking}}">
    <view class="card-title">正在进入…</view>
    <view class="card-desc">正在确认你的微信账号</view>
  </view>

  <view class="card" wx:else>
    <view class="card-title">{{returning ? '欢迎回来' : '创建账号'}}</view>
    <view class="card-desc" wx:if="{{roleLocked && intentRole === 'teacher'}}">本微信已绑定老师身份，退出登录不会改变</view>
    <view class="card-desc" wx:elif="{{roleLocked && intentRole === 'parent'}}">本微信已绑定家长身份，退出登录不会改变</view>
    <view class="card-desc" wx:elif="{{roleLocked}}">本微信已绑定学生身份，退出登录不会改变</view>
    <view class="card-desc" wx:elif="{{returning}}">已识别到你的微信。请选择身份，选定后不能更改</view>
    <view class="card-desc" wx:else>第一次使用会自动注册。请选择学生、老师或家长，一个微信只能绑定一种身份</view>

    <view class="role-row" wx:if="{{!roleLocked}}">
      <view class="role-chip {{intentRole === 'student' ? 'on' : ''}}" data-role="student" bindtap="selectRole">学生</view>
      <view class="role-chip {{intentRole === 'teacher' ? 'on' : ''}}" data-role="teacher" bindtap="selectRole">老师</view>
      <view class="role-chip {{intentRole === 'parent' ? 'on' : ''}}" data-role="parent" bindtap="selectRole">家长</view>
    </view>
    <view class="role-locked" wx:else>
      <view class="role-locked-badge" wx:if="{{intentRole === 'teacher'}}">老师</view>
      <view class="role-locked-badge" wx:elif="{{intentRole === 'parent'}}">家长</view>
      <view class="role-locked-badge" wx:else>学生</view>
      <view class="role-locked-hint">更换身份需要先注销账号</view>
    </view>

    <button class="avatar-btn" bindtap="onPickAvatar">
      <image
        class="avatar-img"
        src="{{avatarTempPath || avatarFileID || '/images/default-avatar.png'}}"
        mode="aspectFill"></image>
      <view class="avatar-badge">+</view>
    </button>

    <view class="nick-row">
      <text class="nick-label">昵称</text>
      <input
        class="nick-input"
        type="text"
        placeholder="匿名用户"
        maxlength="20"
        value="{{nickName}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
        bindnicknamereview="onNickReview"
      />
    </view>

    <button
      class="login-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onLogin">
      <text class="login-btn-label" wx:if="{{submitting}}">正在进入…</text>
      <text class="login-btn-label" wx:elif="{{intentRole === 'teacher'}}">{{returning ? '进入教师工作台' : '教师登录'}}</text>
      <text class="login-btn-label" wx:elif="{{intentRole === 'parent'}}">{{returning ? '进入家长端' : '家长登录'}}</text>
      <text class="login-btn-label" wx:else>{{returning ? '进入错题本' : '微信一键登录'}}</text>
    </button>
  </view>

  <view class="hints" wx:if="{{!checking}}">
    <view class="hint">学生整理错题，老师看班级学情，家长查看孩子情况</view>
    <view class="hint">一个微信号只能选一种身份，退出登录不会改变</view>
  </view>
</view>
