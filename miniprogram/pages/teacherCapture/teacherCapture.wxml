<view class="teacher-shell capture-page">
  <view class="teacher-hero">
    <view class="hero-kicker">CAPTURE</view>
    <view class="hero-title">拍照录入</view>
    <view class="hero-sub">拍试卷或从相册选图，识别后存进这个班的题库。不会进入个人错题本</view>
  </view>

  <view class="section-head"><text class="section-title">班级</text></view>
  <view class="chip-row">
    <view class="chip {{selectedClass.id === item.id ? 'on' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view>
  </view>
  <view class="empty-block" wx:if="{{!classes.length}}">还没有班级<text>先去「班级」新建</text></view>

  <view class="preview-wrap" wx:if="{{imageCount}}">
    <view class="preview-hint">按页序排列 · {{imageCount}}/10 张</view>
    <view class="image-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="id">
        <image class="preview-image" src="{{item.path}}" mode="aspectFill"></image>
        <view class="remove-icon" catchtap="removeImage" data-index="{{index}}">×</view>
        <view class="page-order">
          <text class="order-btn {{index === 0 ? 'off' : ''}}" catchtap="moveImageLeft" data-index="{{index}}">‹</text>
          <text>第{{index + 1}}页</text>
          <text class="order-btn {{index === imageCount - 1 ? 'off' : ''}}" catchtap="moveImageRight" data-index="{{index}}">›</text>
        </view>
      </view>
      <view class="image-item add-item" wx:if="{{canAddMore}}" bindtap="addMoreImages">
        <text class="add-plus">+</text>
        <text class="add-text">继续添加</text>
      </view>
    </view>
    <view class="link-reset" bindtap="resetImage">清空重选</view>
  </view>

  <view class="submit-wrap">
    <button class="primary-btn" bindtap="takePhoto">开始拍照</button>
    <button class="ghost-btn full" bindtap="selectFromGallery">从相册选择</button>
    <button class="primary-btn" wx:if="{{imageCount}}" loading="{{uploading}}" disabled="{{uploading}}" bindtap="submitQuestion">{{uploading ? 'AI识别中...' : processLabel}}</button>
  </view>
</view>
