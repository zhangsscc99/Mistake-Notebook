@import "../../styles/teacher-shell.wxss";

.capture-page { padding-bottom: 48rpx; }

.preview-wrap {
  margin: 8rpx 24rpx 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20px;
  border: 1px solid rgba(11, 22, 51, 0.06);
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.preview-hint {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(11, 22, 51, 0.5);
}

.image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.image-item {
  position: relative;
  height: 200rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: rgba(36, 89, 255, 0.08);
}

.preview-image {
  width: 100%;
  height: 160rpx;
}

.add-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.30);
  background: #fff;
}

.add-plus {
  font-size: 40rpx;
  color: #2459ff;
  font-weight: 700;
  line-height: 1;
}

.add-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #2459ff;
  font-weight: 700;
}

.remove-icon {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  color: #fff;
  background: rgba(11, 22, 51, 0.55);
  font-size: 24rpx;
}

.page-order {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  height: 40rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(11, 22, 51, 0.45);
}

.order-btn.off { opacity: 0.35; }

.link-reset {
  margin-top: 16rpx;
  text-align: center;
  color: #2459ff;
  font-size: 22rpx;
  font-weight: 700;
}

.submit-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 24rpx;
}

.ghost-btn.full {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
