<view class="teacher-shell hw-page">
  <view class="teacher-hero">
    <view class="hero-kicker">HOMEWORK</view>
    <view class="hero-title">作业批改</view>
    <view class="hero-sub">学生提交后在这里按题判对错并打分。先组卷生成试卷，打开后再发给班级。</view>
    <button class="ghost-btn hero-btn" bindtap="goPaper">去组卷</button>
  </view>

  <view class="white-card tap-card" wx:for="{{assignments}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <view class="hw-title">{{item.title}}</view>
    <view class="hw-meta">{{item.className || '班级'}} · {{item.questionCount}} 道题 · {{item.dueText}}</view>
    <view class="hw-stats">
      <text class="badge">已交 {{item.submitted}}/{{item.studentCount}}</text>
      <text class="badge status-missing">未交 {{item.missing}}</text>
      <text class="badge status-graded">已批 {{item.graded}}</text>
    </view>
  </view>
  <view class="empty-block" wx:if="{{!assignments.length}}">还没有作业<text>先去组卷生成试卷，打开后再发给班级</text></view>
</view>
