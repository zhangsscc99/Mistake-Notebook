<view class="assignment-page"><view class="head"><view class="kicker">ASSIGNMENTS</view><view class="title">布置作业</view><view class="sub">从班级错题中选择题目发布</view></view><picker range="{{classes}}" range-key="name" bindchange="onClass"><view class="picker">{{selectedClass.name || '选择班级'}}</view></picker><input class="input" value="{{title}}" bindinput="onTitle" placeholder="作业名称"/><view class="q" wx:for="{{questions}}" wx:key="id" data-id="{{item.id}}" bindtap="toggle"><view class="check {{item.checked?'on':''}}">{{item.checked?'✓':''}}</view><text>{{item.content}}</text></view><view class="published" wx:if="{{assignments.length}}"><view class="published-title">已布置作业</view><view class="published-item" wx:for="{{assignments}}" wx:key="_id" data-index="{{index}}" bindtap="viewSubmissions">{{item.title}} · {{item.questionIds.length}} 题 <text>查看提交 ›</text></view></view><button class="submit" bindtap="publish">发布作业（{{selectedCount}}）</button></view>
