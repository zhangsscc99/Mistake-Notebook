.assignment-page{min-height:100vh;background:#eaf3ff;color:#0b1633;padding-bottom:120rpx}.head{padding:44rpx 32rpx 36rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff 58%,#b6a6ff)}.kicker{font-size:20rpx;letter-spacing:3rpx;opacity:.72}.title{margin-top:14rpx;font-size:38rpx;font-weight:800}.sub{margin-top:10rpx;font-size:23rpx;opacity:.82}.picker,.input{margin:22rpx 24rpx 0;height:70rpx;line-height:70rpx;padding:0 22rpx;border-radius:14rpx;background:#fff;font-size:26rpx}.input{box-sizing:border-box;margin-top:14rpx}.q{display:flex;align-items:flex-start;margin:12rpx 24rpx 0;padding:22rpx;border-radius:16rpx;background:#fff;font-size:24rpx;line-height:1.5}.check{width:38rpx;height:38rpx;margin-right:16rpx;border:2rpx solid #aab8d8;border-radius:50%;text-align:center;line-height:34rpx;color:#fff;flex:none}.check.on{border-color:#2459ff;background:#2459ff}.submit{position:fixed;left:24rpx;right:24rpx;bottom:28rpx;height:82rpx;line-height:82rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff)}.submit::after{border:0}
