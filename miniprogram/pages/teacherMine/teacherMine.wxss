.hero-copy .hero-title {
  margin-top: 6rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(11, 22, 51, 0.06);
}

.cell:last-child { border-bottom: none; }

.cell-label { font-size: 28rpx; color: #0b1633; font-weight: 600; }
.cell-arrow { color: rgba(11, 22, 51, 0.3); font-size: 32rpx; }
.danger { color: #e11d48; }

.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-avatar-btn {
  width: 112rpx !important;
  height: 112rpx !important;
  padding: 0;
  margin: 0;
  line-height: 0;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.hero-avatar-btn::after {
  border: none;
}

.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.18);
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nick-label {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1633;
}

.nick-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 24rpx;
  background: #f1f4fb;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #0b1633;
}

.nick-save {
  margin-top: 24rpx !important;
}

.profile-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.42);
  line-height: 1.5;
}
