.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(11, 22, 51, 0.06);
}

.cell:last-child { border-bottom: none; }

.cell-label { font-size: 28rpx; color: #0b1633; font-weight: 600; }
.cell-arrow { color: rgba(11, 22, 51, 0.3); font-size: 32rpx; }
.danger { color: #e11d48; }
