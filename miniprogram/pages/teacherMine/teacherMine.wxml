<view class="teacher-shell">
  <view class="teacher-hero">
    <view class="hero-top">
      <button class="hero-avatar-btn" bindtap="onPickAvatar" disabled="{{uploadingAvatar}}">
        <image class="hero-avatar" src="{{avatarFileID || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>
      <view class="hero-copy">
        <view class="hero-kicker">TEACHER</view>
        <view class="hero-title">{{nickName || '教师'}}</view>
      </view>
    </view>
    <view class="hero-sub">拍照识别进老师题库，不进学生错题本。组卷页组建试卷后，打开再发给任意班级。</view>
    <view class="hero-stats">
      <view class="hero-stat" data-focus="" bindtap="goClass"><text>{{classCount}}</text><label>班级</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" data-focus="students" bindtap="goClass"><text>{{studentCount}}</text><label>学生</label></view>
      <view class="hero-divider"></view>
      <view class="hero-stat" bindtap="goAssignments"><text>{{assignmentCount}}</text><label>作业</label></view>
    </view>
  </view>

  <view class="section-head"><text class="section-title">教学</text></view>
  <view class="white-card">
    <view class="cell" bindtap="goAssignments">
      <text class="cell-label">作业批改</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goPaper">
      <text class="cell-label">班级组卷</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goReport">
      <text class="cell-label">家长报告</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goCapture">
      <text class="cell-label">拍照识别</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goQuestions">
      <text class="cell-label">全班题目</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="section-head"><text class="section-title">个人资料</text></view>
  <view class="white-card">
    <view class="nick-row">
      <text class="nick-label">昵称</text>
      <input
        class="nick-input"
        type="text"
        value="{{nickName}}"
        maxlength="20"
        placeholder="选填，方便学生认出你"
        bindinput="onNickInput"
      />
    </view>
    <button class="primary-btn nick-save" bindtap="onSaveNick" disabled="{{saving}}">
      {{saving ? '保存中…' : '保存昵称'}}
    </button>
    <view class="profile-hint">不读取微信头像和昵称。点上方头像可从相册或拍照上传。</view>
  </view>

  <view class="section-head"><text class="section-title">账号</text></view>
  <view class="white-card">
    <view class="cell" bindtap="onLogout">
      <text class="cell-label">退出登录</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onDeleteAccount">
      <text class="cell-label danger">注销账号</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>
  <view class="empty-block"><text>退出登录后可重新选择学生、老师或家长。班级和学生错题数据都会保留；注销才会删除云端数据。</text></view>
  <teacher-tabbar active="mine"></teacher-tabbar>
</view>
