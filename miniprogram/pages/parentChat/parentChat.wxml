<view class="teacher-chat">
  <view class="chip-row">
    <view class="chip {{selectedChild.studentId === item.studentId ? 'on' : ''}}" wx:for="{{children}}" wx:key="studentId" data-id="{{item.studentId}}" bindtap="selectChild">{{item.nickName}}</view>
  </view>
  <view class="chat-hint">根据孩子的错题和作业，帮您看薄弱学科、最近错在哪、今晚怎么复习。</view>
  <scroll-view class="msg-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTop}}" scroll-with-animation>
    <view class="msg-list">
      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.typing}}" class="typing-row">
          <view class="typing-card">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
            <text class="typing-label">正在根据孩子的错题思考</text>
          </view>
        </view>
        <view wx:if="{{!item.typing}}" class="msg-row {{item.role === 'user' ? 'msg-row-user' : ''}}">
          <view class="msg-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <text class="msg-text">{{item.content}}</text>
          </view>
        </view>
      </block>
    </view>
    <view class="suggest-row" wx:if="{{messages.length === 1 && !sending}}">
      <view class="suggest-chip" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="useSuggestion">{{item}}</view>
    </view>
  </scroll-view>
  <view class="input-bar">
    <view class="wait-bar" wx:if="{{sending}}">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
      <text class="wait-text">正在根据孩子的错题思考…</text>
    </view>
    <view class="input-row">
      <input class="chat-input" value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="send" placeholder="问问孩子的学习情况" disabled="{{sending}}" />
      <button class="send-btn" disabled="{{sending}}" bindtap="send">{{sending ? '思考中' : '发送'}}</button>
    </view>
  </view>
  <parent-tabbar active="chat"></parent-tabbar>
</view>
