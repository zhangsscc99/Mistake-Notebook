.notebook-page{min-height:100vh;background:#eaf3ff;color:#0b1633;padding-bottom:120rpx}.notebook-head{padding:44rpx 32rpx 36rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff 58%,#b6a6ff)}.kicker{font-size:20rpx;letter-spacing:3rpx;opacity:.72}.title{margin-top:14rpx;font-size:38rpx;font-weight:800}.sub{margin-top:10rpx;font-size:23rpx;opacity:.82}.form{margin:22rpx 24rpx 16rpx;padding:20rpx;border-radius:18rpx;background:#fff}.picker,.title-input{height:70rpx;line-height:70rpx;padding:0 22rpx;border-radius:12rpx;background:#f1f5ff;font-size:26rpx}.picker text{float:right;color:#2459ff}.title-input{margin-top:14rpx;box-sizing:border-box}.question{display:flex;align-items:flex-start;margin:0 24rpx 12rpx;padding:22rpx;border-radius:16rpx;background:rgba(255,255,255,.88)}.check{width:38rpx;height:38rpx;margin-right:18rpx;border:2rpx solid #aab8d8;border-radius:50%;text-align:center;line-height:34rpx;color:#fff}.check.checked{border-color:#2459ff;background:#2459ff}.q-content{flex:1;font-size:25rpx;line-height:1.5}.publish{position:fixed;left:24rpx;right:24rpx;bottom:28rpx;height:82rpx;line-height:82rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff);font-size:28rpx}.publish::after{border:0}
