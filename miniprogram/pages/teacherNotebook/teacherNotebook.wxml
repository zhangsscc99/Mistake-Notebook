<view class="notebook-page"><view class="notebook-head"><view class="kicker">CLASS NOTEBOOK</view><view class="title">整理班级错题本</view><view class="sub">从题库中选择题目，推送给当前班级</view></view><view class="form"><picker mode="selector" range="{{classes}}" range-key="name" bindchange="onClassChange"><view class="picker">{{selectedClass.name || '选择班级'}} <text>⌄</text></view></picker><input class="title-input" value="{{title}}" bindinput="onTitleInput" placeholder="错题本名称" /></view><view class="question-list"><view class="question" wx:for="{{questions}}" wx:key="id" data-id="{{item.id}}" bindtap="toggle"><view class="check {{item.checked?'checked':''}}">{{item.checked?'✓':''}}</view><view class="q-content">{{item.content}}</view></view></view><button class="publish" bindtap="publish">发布给班级（{{selectedCount}}）</button></view>
