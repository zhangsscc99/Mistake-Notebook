  background: rgba(255, 255, 255, 0.18) !important;
  color: #fff !important;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.45);
}

.hero-dates {
  margin: 20rpx 0 0;
}

.hero-dates .date-sep {
  color: rgba(255, 255, 255, 0.72);
}

.his-title {
  font-size: 28rpx;
