/* pages/reportList/reportList.wxss */
.report-list-page {
  min-height: 100vh;
  padding: 16px 16px 40px;
  box-sizing: border-box;
  background-color: #eef3fb;
  background-image:
    radial-gradient(circle 420rpx at 100% 0%, rgba(82, 183, 255, 0.12) 0%, transparent 60%),
    radial-gradient(circle 360rpx at 0% 4%, rgba(182, 166, 255, 0.10) 0%, transparent 55%),
    linear-gradient(rgba(11, 22, 51, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11, 22, 51, 0.025) 1px, transparent 1px);
  background-size: auto, auto, 44rpx 44rpx, 44rpx 44rpx;
}

.list-loading {
  text-align: center;
  padding: 80px 0;
  font-size: 14px;
  color: rgba(11, 22, 51, 0.45);
}

.report-card {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border: 1px solid rgba(11, 22, 51, 0.06);
  border-radius: 18px;
  padding: 18px 16px;
  margin-bottom: 12px;
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.report-card-main {
  flex: 1;
  min-width: 0;
}

.report-card-title {
  font-size: 15px;
  font-weight: 800;
  color: #0b1633;
  margin-bottom: 6px;
  line-height: 1.4;
}

.report-card-preview {
  font-size: 13px;
  color: rgba(11, 22, 51, 0.55);
  line-height: 1.6;
  margin-bottom: 10px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.report-card-meta {
  display: flex;
  align-items: center;
  gap: 10px;
}

.report-card-pill {
  font-size: 11px;
  font-weight: 700;
  color: #2459ff;
  background: rgba(36, 89, 255, 0.08);
  padding: 2px 10px;
  border-radius: 999px;
  white-space: nowrap;
}

.report-card-time {
  font-size: 12px;
  color: rgba(11, 22, 51, 0.45);
  white-space: nowrap;
}

.report-card-delete {
  flex-shrink: 0;
  font-size: 12px;
  color: rgba(225, 29, 72, 0.75);
  padding: 4px 2px 4px 12px;
}

.list-footer-hint {
  text-align: center;
  font-size: 12px;
  color: rgba(11, 22, 51, 0.40);
  padding: 16px 0;
}

.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100px 24px 0;
  text-align: center;
}

.list-empty-title {
  display: block;
  width: 100%;
  font-size: 17px;
  font-weight: 700;
  color: #0b1633;
  margin-bottom: 10px;
  text-align: center;
}

.list-empty-sub {
  display: block;
  width: 100%;
  font-size: 13px;
  color: rgba(11, 22, 51, 0.50);
  line-height: 1.7;
  margin-bottom: 24px;
  text-align: center;
}

.list-empty-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 360rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  padding: 0 !important;
  margin: 0 auto !important;
  line-height: 1 !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 999px !important;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%) !important;
  color: #ffffff !important;
  border: none !important;
  box-sizing: border-box !important;
  text-align: center !important;
  box-shadow: 0 10px 24px rgba(31, 91, 255, 0.30) !important;
}

.list-empty-btn::after {
  border: none !important;
}
