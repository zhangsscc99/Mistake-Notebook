/* pages/aiChat/aiChat.wxss */
/* 绝对铺满「导航栏 ~ tab 栏」之间的页面盒子。
   不要用 100vh / windowHeight：DevTools 和真机都会把 tab 栏高度算进去，
   输入行就会被 tab 栏盖住，只剩上面那句免责声明。 */
page {
  height: 100%;
  overflow: hidden;
}

.ai-chat-page {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background-color: #eef3fb;
  background-image:
    radial-gradient(circle 420rpx at 100% 0%, rgba(82, 183, 255, 0.12) 0%, transparent 60%),
    radial-gradient(circle 360rpx at 0% 4%, rgba(182, 166, 255, 0.10) 0%, transparent 55%),
    linear-gradient(rgba(11, 22, 51, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11, 22, 51, 0.025) 1px, transparent 1px);
  background-size: auto, auto, 44rpx 44rpx, 44rpx 44rpx;
}

/* 今日额度条。刻意做得比 context-bar 轻 —— 它是个常驻的提示，
   不该跟「正在答疑」的题目条抢注意力 */
.quota-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  margin: 16rpx 24rpx 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(36, 89, 255, 0.07);
}

.quota-text {
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.55);
}

.quota-hint {
  font-size: 20rpx;
  color: #2459ff;
}

/* 快用完时转成警示色，让用户有机会在看到硬拦截之前就去兑换 */
.quota-low {
  background: rgba(255, 138, 0, 0.12);
}

.quota-low .quota-text {
  color: #b25c00;
}

/* 题目上下文条 */
.context-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 1px solid rgba(11, 22, 51, 0.06);
  box-shadow: 0 12rpx 36rpx rgba(11, 22, 51, 0.06);
}

.context-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: linear-gradient(140deg, #2459ff 0%, #52b7ff 55%, #b6a6ff 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(31, 91, 255, 0.30);
}

.context-body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.context-label {
  font-size: 22rpx;
  color: #2459ff;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.context-text {
  font-size: 26rpx;
  color: rgba(11, 22, 51, 0.6);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-chevron {
  flex-shrink: 0;
  align-self: center;
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
  padding: 8rpx 22rpx;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(31, 91, 255, 0.28);
}

/* 题目详情浮窗 */
.context-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background: rgba(11, 22, 51, 0.45);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease;
}

.context-modal.show {
  opacity: 1;
  visibility: visible;
}

.context-modal-card {
  width: 100%;
  max-width: 620rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 30rpx 80rpx rgba(11, 22, 51, 0.30);
  transform: scale(0.92);
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.context-modal.show .context-modal-card {
  transform: scale(1);
}

.modal-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 26rpx 20rpx;
  border-bottom: 1px solid rgba(11, 22, 51, 0.06);
}

.modal-card-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: linear-gradient(140deg, #2459ff 0%, #52b7ff 55%, #b6a6ff 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(31, 91, 255, 0.28);
}

.modal-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 800;
  color: #0b1633;
  letter-spacing: 0.5rpx;
}

.modal-card-close {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(11, 22, 51, 0.45);
  background: rgba(11, 22, 51, 0.05);
  border-radius: 50%;
}

.modal-card-scroll {
  box-sizing: border-box;
  width: 100%;
  max-height: calc(70vh - 100rpx);
}

.modal-card-inner {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 26rpx 28rpx;
}

/* 结构化题目段落 */
.q-para {
  box-sizing: border-box;
  width: 100%;
}

.q-para-stem {
  font-size: 29rpx;
  line-height: 1.75;
  color: #1a2440;
}

.q-para-stem + .q-para-stem {
  margin-top: 16rpx;
}

.q-para-sub {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 18rpx 18rpx 18rpx 16rpx;
  background: rgba(36, 89, 255, 0.04);
  border-radius: 14rpx;
  border-left: 5rpx solid #2459ff;
}

.q-para-label {
  flex-shrink: 0;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #2459ff, #52b7ff);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.q-para-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1a2440;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.q-para-stem .q-para-text {
  font-size: 29rpx;
}

/* 消息区：height:0 + flex:1 才能在绝对定位父级里真正吃掉剩余高度 */
.msg-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.msg-list {
  padding: 28rpx 24rpx 16rpx;
}

.msg-row {
  display: flex;
  /* 头像对齐气泡首行；用 flex-end 时多行长气泡会把头像压到整个气泡的下沿 */
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

/* 用户消息：DOM 顺序是 [气泡][头像]，靠右排即头像落在最右外缘，与 AI 行镜像对称。
   不能用 row-reverse —— 那会让头像跑到气泡左侧、悬在屏幕中间。 */
.msg-row-user {
  justify-content: flex-end;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.msg-avatar-ai {
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(31, 91, 255, 0.28);
}

.msg-avatar-user {
  background: #ffffff;
  color: #2459ff;
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.25);
}

/* 用户头像图。尺寸和圆角必须和 .msg-avatar 完全一致，
   否则盖不住外层那圈 inset 描边，会在四角露出白边 */
.msg-avatar-img {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  line-height: 1.6;
}

.bubble-ai {
  /* 助手回答普遍更长，行宽放宽一些减少换行；60rpx 的余量保证不会顶到头像 */
  max-width: 78%;
  background: #ffffff;
  color: #1a2440;
  border-bottom-left-radius: 6rpx;
  border: 1px solid rgba(11, 22, 51, 0.05);
  box-shadow: 0 10rpx 30rpx rgba(11, 22, 51, 0.06);
}

.bubble-user {
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 10rpx 26rpx rgba(31, 91, 255, 0.30);
}

.msg-text {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  color: inherit;
}

.bubble-user .msg-text {
  color: #ffffff;
}

.typing-row {
  padding: 0 0 20rpx;
}

.typing-card,
.wait-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(36, 89, 255, 0.12);
  box-sizing: border-box;
}

.wait-bar {
  margin-bottom: 12rpx;
}

.typing-card .dot,
.wait-bar .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2459ff;
  animation: typing-bounce 1.2s infinite ease-in-out;
}

.typing-card .dot:nth-child(2),
.wait-bar .dot:nth-child(2) { animation-delay: 0.2s; }
.typing-card .dot:nth-child(3),
.wait-bar .dot:nth-child(3) { animation-delay: 0.4s; }

.typing-label {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2459ff;
}

.wait-text {
  margin-left: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #2459ff;
}

@keyframes typing-bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.35; }
  40% { transform: translateY(-10rpx); opacity: 1; }
}

.scroll-pad {
  width: 100%;
}

/* 底部输入栏：tab 栏已经占了 Home 指示条，这里不要再加 safe-area，否则输入行会被裁掉 */
.input-bar {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex-shrink: 0;
  z-index: 10;
  padding: 10rpx 24rpx 12rpx;
  background: #ffffff;
  border-top: 1px solid rgba(11, 22, 51, 0.06);
}

.ai-disclaimer {
  padding: 0 8rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(11, 22, 51, 0.38);
  text-align: center;
  letter-spacing: 0.5rpx;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  background: #f1f4fb;
  border-radius: 999rpx;
  font-size: 29rpx;
  color: #0b1633;
}

.input-placeholder {
  color: rgba(11, 22, 51, 0.38);
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 76rpx;
  line-height: 1;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(36, 89, 255, 0.30);
  border: none;
  box-sizing: border-box;
  text-align: center;
  transition: background 0.2s, box-shadow 0.2s;
}

.send-btn::after {
  border: none;
}

.send-btn-active {
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
  box-shadow: 0 8rpx 20rpx rgba(31, 91, 255, 0.30);
}
