.teacher-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 48rpx; background: #eaf3ff; color: #0b1633; }
.teacher-hero { padding: 46rpx 32rpx 38rpx; color: #fff; background: linear-gradient(135deg,#2459ff,#52b7ff 58%,#b6a6ff); }
.hero-kicker { font-size: 20rpx; letter-spacing: 3rpx; opacity: .72; }.hero-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 800; }.hero-subtitle { margin-top: 10rpx; font-size: 24rpx; opacity: .82; }
.hero-stats { display:flex; align-items:center; justify-content:space-between; margin-top:38rpx; }.hero-stat { display:flex; flex-direction:column; align-items:center; min-width:150rpx; }.hero-stat text { font-size:36rpx; font-weight:800; }.hero-stat label { margin-top:8rpx; font-size:21rpx; opacity:.78; }.hero-divider { width:1rpx; height:44rpx; background:rgba(255,255,255,.35); }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:30rpx 28rpx 16rpx; font-size:28rpx; font-weight:700; }.section-note { font-size:23rpx; color:rgba(11,22,51,.48); font-weight:500; }.add-btn { width:200rpx!important; height:62rpx; line-height:62rpx; margin:0; padding:0; border:0; border-radius:999rpx; color:#2459ff; background:rgba(36,89,255,.1); font-size:23rpx; }.add-btn::after,.secondary-btn::after { border:0; }
.class-card,.student-card,.empty-card,.access-card { margin:0 24rpx 16rpx; padding:24rpx; border:1rpx solid rgba(47,107,255,.13); border-radius:20rpx; background:rgba(255,255,255,.86); box-shadow:0 12rpx 34rpx rgba(11,22,51,.06); }.class-card,.student-card { display:flex; align-items:center; justify-content:space-between; }.class-main { display:flex; align-items:center; }.class-dot { width:18rpx; height:18rpx; margin-right:18rpx; border-radius:50%; background:#2459ff; box-shadow:0 0 0 8rpx rgba(36,89,255,.1); }.class-name,.student-name { font-size:29rpx; font-weight:700; }.class-meta,.student-meta { margin-top:8rpx; font-size:22rpx; color:rgba(11,22,51,.52); }.class-code { color:#2459ff; font-size:24rpx; }.class-code text,.student-arrow { margin-left:10rpx; color:rgba(11,22,51,.3); font-size:32rpx; }.students-head { margin-top:38rpx; }.student-avatar { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin-right:18rpx; border-radius:50%; color:#2459ff; background:#eaf1ff; font-size:30rpx; font-weight:700; }.student-info { flex:1; }.empty-card,.access-card { display:flex; flex-direction:column; align-items:center; padding:46rpx 24rpx; color:rgba(11,22,51,.6); }.empty-hint,.access-desc { margin-top:12rpx; color:rgba(11,22,51,.4); font-size:22rpx; }.access-icon { display:flex; align-items:center; justify-content:center; width:86rpx; height:86rpx; border-radius:26rpx; color:#2459ff; background:#eaf1ff; font-size:34rpx; font-weight:700; }.access-title { margin-top:20rpx; color:#0b1633; font-size:29rpx; font-weight:700; }.secondary-btn { width:240rpx!important; height:68rpx; line-height:68rpx; margin:28rpx 0 0; padding:0; border:0; border-radius:999rpx; color:#fff; background:linear-gradient(135deg,#2459ff,#52b7ff); font-size:25rpx; }.actions-head { margin-top:38rpx; }.tool-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin:0 24rpx; }.tool-card { padding:24rpx; border:1rpx solid rgba(47,107,255,.12); border-radius:18rpx; background:rgba(255,255,255,.78); }.tool-icon { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:16rpx; color:#2459ff; background:#eaf1ff; font-size:25rpx; font-weight:700; }.tool-title { margin-top:18rpx; font-size:26rpx; font-weight:700; }.tool-desc { margin-top:8rpx; color:rgba(11,22,51,.46); font-size:21rpx; }.loading { padding:80rpx 0; text-align:center; color:rgba(11,22,51,.48); font-size:24rpx; }
