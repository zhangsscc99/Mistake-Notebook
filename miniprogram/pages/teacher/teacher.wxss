@import "../../styles/teacher-shell.wxss";

.class-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #2459ff;
  box-shadow: 0 0 0 8rpx rgba(36, 89, 255, 0.1);
}

.class-main {
  flex: 1;
}

.class-name,
.student-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #0b1633;
}

.class-meta,
.student-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.52);
}

.class-code {
  color: #2459ff;
  font-size: 24rpx;
  font-weight: 700;
}

.student-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #2459ff;
  background: #eaf1ff;
  font-size: 30rpx;
  font-weight: 700;
}

.student-info {
  flex: 1;
}

.student-arrow {
  color: rgba(11, 22, 51, 0.3);
  font-size: 32rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 24rpx;
}

.tool-card {
  padding: 24rpx;
  background: #fff;
  border-radius: 18px;
  border: 1px solid rgba(11, 22, 51, 0.06);
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.tool-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0b1633;
}

.tool-desc {
  margin-top: 8rpx;
  color: rgba(11, 22, 51, 0.46);
  font-size: 21rpx;
}

.access-card {
  margin: 48rpx 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  background: #fff;
  border-radius: 20px;
}

.access-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0b1633;
}

.access-desc {
  margin-top: 12rpx;
  color: rgba(11, 22, 51, 0.48);
  font-size: 24rpx;
  line-height: 1.6;
}

.on-class {
  box-shadow: inset 0 0 0 2rpx rgba(36, 89, 255, 0.35);
}
