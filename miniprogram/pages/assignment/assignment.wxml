<view class="assignment-page"><view class="head"><view class="title">{{assignment.title}}</view><view class="sub">共 {{questions.length}} 道题</view></view><view class="question" wx:for="{{questions}}" wx:key="id"><view class="question-text">{{index+1}}. {{item.content}}</view><textarea class="answer" data-index="{{index}}" bindinput="onAnswer" value="{{answers[index]}}" placeholder="写下你的答案或解题过程" auto-height="{{true}}" /></view><button class="submit" bindtap="submit">提交作业</button></view>
