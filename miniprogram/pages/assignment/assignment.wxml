<view class="assignment-page {{canSubmit ? 'has-submit' : ''}}">
  <view class="head">
    <view class="kicker">作业</view>
    <view class="title">{{title}}</view>
    <view class="sub">{{meta}}</view>
    <view class="status-pill {{status}}" wx:if="{{statusText}}">{{statusText}}</view>
    <view class="score-line" wx:if="{{status === 'graded' && scoreText}}">{{scoreText}} 分</view>
    <view class="comment-card" wx:if="{{status === 'graded' && comment}}">{{comment}}</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载作业…</view>

  <view class="q-card" wx:for="{{questions}}" wx:key="id">
    <view class="q-index-row">
      <view class="q-index">第 {{item.index}} 题</view>
      <text class="result-badge {{item.result}}" wx:if="{{item.resultLabel}}">{{item.resultLabel}}</text>
    </view>
    <view class="q-content">{{item.content}}</view>
    <view class="img-frame" wx:if="{{item.imageUrl}}">
      <image class="q-image" src="{{item.imageUrl}}" mode="aspectFill" binderror="clearImage" data-index="{{index}}"></image>
      <view class="img-preview" catchtap="previewImage" data-url="{{item.imageUrl}}">查看原图</view>
    </view>
    <textarea
      class="answer {{readOnly ? 'locked' : ''}}"
      data-index="{{index}}"
      value="{{answers[index]}}"
      placeholder="{{readOnly ? '未作答' : '写下你的答案或解题过程，也可以只上传图片'}}"
      disabled="{{readOnly}}"
      auto-height="{{true}}"
      maxlength="2000"
      bindinput="onAnswer"
    />
    <view class="ans-img-frame" wx:if="{{answerImages[index]}}">
      <image class="q-image" src="{{answerImages[index]}}" mode="aspectFill" bindtap="previewImage" data-url="{{answerImages[index]}}"></image>
      <view class="img-preview" catchtap="previewImage" data-url="{{answerImages[index]}}">查看原图</view>
      <view class="img-remove" wx:if="{{!readOnly}}" catchtap="removeAnswerImage" data-index="{{index}}">删除图片</view>
    </view>
    <view class="pick-row" wx:if="{{!readOnly}}">
      <view class="pick-btn" data-index="{{index}}" data-source="camera" bindtap="chooseAnswerImage">拍照</view>
      <view class="pick-btn" data-index="{{index}}" data-source="album" bindtap="chooseAnswerImage">相册</view>
      <text class="pick-hint" wx:if="{{uploadingIndex == index}}">正在上传…</text>
      <text class="pick-hint" wx:elif="{{answerImages[index]}}">可换一张</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !questions.length}}">这份作业里没有可显示的题目</view>

  <view class="submit-wrap" wx:if="{{!loading && canSubmit}}">
    <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitLabel}}</button>
  </view>
</view>
