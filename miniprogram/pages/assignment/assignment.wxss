.assignment-page{min-height:100vh;padding-bottom:120rpx;background:#eaf3ff;color:#0b1633}.head{padding:44rpx 32rpx 36rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff 58%,#b6a6ff)}.title{font-size:38rpx;font-weight:800}.sub{margin-top:10rpx;font-size:23rpx;opacity:.82}.question{margin:18rpx 24rpx 0;padding:24rpx;border-radius:18rpx;background:#fff}.question-text{font-size:27rpx;line-height:1.55}.answer{width:100%;min-height:100rpx;margin-top:20rpx;padding:18rpx;box-sizing:border-box;border-radius:12rpx;background:#f1f5ff;font-size:25rpx}.submit{position:fixed;left:24rpx;right:24rpx;bottom:28rpx;height:82rpx;line-height:82rpx;border:0;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff);font-size:28rpx}.submit::after{border:0}
