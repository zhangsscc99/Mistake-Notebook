<!--pages/index/index.wxml-->
<view class="index-page">
  <!-- 多色背景光晕层 -->
  <view class="bg-blob bg-blob-blue"></view>
  <view class="bg-blob bg-blob-pink"></view>
  <view class="bg-blob bg-blob-purple"></view>
  <view class="bg-blob bg-blob-peach"></view>

  <!-- 顶部导航栏 -->
  <view class="top-bar">
    <!-- 头像用 image + bindtap，不能做成 chooseAvatar 按钮：
         那会让用户绕开「我的」页的 openid 就绪检查直接上传 -->
    <view class="top-bar-left" bindtap="goProfile">
      <image
        class="top-bar-avatar"
        src="{{avatarFileID || '/images/default-avatar.png'}}"
        mode="aspectFill"></image>
      <text class="top-bar-greet">{{greeting}}</text>
    </view>
    <button class="top-bar-share" open-type="share">分享</button>
  </view>

  <view class="main-section">
    <view class="content-container">

      <!-- 产品介绍（无图片时） -->
      <view class="product-guide" wx:if="{{imageCount === 0}}">
        <view class="guide-header">
          <view class="guide-title">智卷错题通</view>
          <view class="guide-subtitle">智能识别 · 自动分类 · 高效复习</view>
        </view>

        <view class="guide-features">
          <view class="feature-item">
            <view class="feature-text">
              <view class="feature-h4">拍照识别</view>
              <view class="feature-p">支持一次多张上传。题目如果跨页，把两张照片一起上传，会自动智能合并</view>
            </view>
          </view>
          <view class="feature-item">
            <view class="feature-text">
              <view class="feature-h4">智能分类</view>
              <view class="feature-p">大模型自动分析题目类型并归类整理</view>
            </view>
          </view>
          <view class="feature-item">
            <view class="feature-text">
              <view class="feature-h4">组卷练习</view>
              <view class="feature-p">自由组合错题生成试卷，支持打印导出</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 已选择的图片预览：按页序排列，可左右调序 -->
      <view class="image-preview-area" wx:if="{{imageCount > 0}}">
        <view class="preview-hint">按页序排列 · {{imageCount}}/10 张</view>
        <view class="image-grid">
          <view class="image-item" wx:for="{{images}}" wx:key="id">
            <image class="preview-image" src="{{item.path}}" mode="aspectFill"></image>
            <view class="image-overlay">
              <view class="remove-icon" catchtap="removeImage" data-index="{{index}}">×</view>
            </view>
            <view class="page-order">
              <text class="order-btn {{index === 0 ? 'disabled' : ''}}" catchtap="moveImageLeft" data-index="{{index}}">‹</text>
              <text class="page-no">第{{index + 1}}页</text>
              <text class="order-btn {{index === imageCount - 1 ? 'disabled' : ''}}" catchtap="moveImageRight" data-index="{{index}}">›</text>
            </view>
          </view>
          <view class="image-item add-item" wx:if="{{canAddMore}}" bindtap="addMoreImages">
            <text class="add-plus">+</text>
            <text class="add-text">继续添加</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-area">
        <view class="action-buttons">
          <button class="action-btn action-btn-primary" bindtap="takePhoto">开始拍照</button>
          <button class="action-btn action-btn-default" bindtap="selectFromGallery">从相册选择</button>
        </view>
        <button class="process-btn" wx:if="{{imageCount > 0}}"
          loading="{{uploading}}" disabled="{{uploading}}" bindtap="submitQuestion">
          {{uploading ? 'AI识别中...' : processLabel}}
        </button>
      </view>

    </view>
  </view>

  <!-- 最近处理 -->
  <view class="recent-section" wx:if="{{recentRecords.length > 0}}">
    <view class="recent-divider">
      <view class="divider-line"></view>
      <text class="divider-text">最近处理</text>
      <view class="divider-line"></view>
    </view>
    <view class="recent-list">
      <view
        class="recent-item"
        wx:for="{{recentRecords}}"
        wx:key="id"
        bindtap="viewRecord"
        data-categoryid="{{item.categoryId}}"
        data-categoryname="{{item.categoryName}}"
      >
        <view class="recent-info">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-time">{{item.timeText}}</text>
        </view>
        <text class="recent-arrow">›</text>
      </view>
    </view>
  </view>
</view>
