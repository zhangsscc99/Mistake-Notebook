.classes-page{min-height:100vh;padding-bottom:48rpx;background:#eaf3ff;color:#0b1633}.classes-header{padding:46rpx 32rpx 38rpx;color:#fff;background:linear-gradient(135deg,#2459ff,#52b7ff 58%,#b6a6ff)}.header-kicker{font-size:20rpx;letter-spacing:3rpx;opacity:.72}.header-title{margin-top:14rpx;font-size:42rpx;font-weight:800}.header-sub{margin-top:10rpx;font-size:24rpx;opacity:.82}.message-card,.class-card{margin:22rpx 24rpx 0;padding:24rpx;border:1rpx solid rgba(47,107,255,.13);border-radius:20rpx;background:rgba(255,255,255,.88);box-shadow:0 12rpx 34rpx rgba(11,22,51,.06)}.message-top{display:flex;justify-content:space-between;align-items:center}.message-class{font-size:25rpx;font-weight:700;color:#2459ff}.message-time{font-size:20rpx;color:rgba(11,22,51,.4)}.message-content{margin-top:14rpx;font-size:27rpx;line-height:1.6}.class-card{position:relative}.class-name{font-size:29rpx;font-weight:700}.class-meta{margin-top:8rpx;font-size:22rpx;color:rgba(11,22,51,.52)}.class-code{position:absolute;right:24rpx;top:28rpx;color:#2459ff;font-size:22rpx;font-weight:700;white-space:nowrap}
.class-code.pending{color:#d97706}.empty,.loading{padding:90rpx 0;text-align:center;color:rgba(11,22,51,.48);font-size:25rpx}.empty text{display:block;margin-top:12rpx;font-size:22rpx;color:rgba(11,22,51,.35)}
.assignment-card{margin:0 24rpx 16rpx;padding:24rpx;border:1rpx solid rgba(47,107,255,.13);border-radius:20rpx;background:rgba(255,255,255,.88)}
.assignment-action{margin-top:14rpx;color:#2459ff;font-size:24rpx;font-weight:700}
