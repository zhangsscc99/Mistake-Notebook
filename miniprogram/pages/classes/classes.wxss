.classes-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  color: #0b1633;
  background-color: #eef3fb;
  background-image:
    radial-gradient(circle 420rpx at 100% 0%, rgba(82, 183, 255, 0.12) 0%, transparent 60%),
    radial-gradient(circle 360rpx at 0% 4%, rgba(182, 166, 255, 0.10) 0%, transparent 55%),
    linear-gradient(rgba(11, 22, 51, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11, 22, 51, 0.025) 1px, transparent 1px);
  background-size: auto, auto, 44rpx 44rpx, 44rpx 44rpx;
}

.classes-header {
  padding: 46rpx 32rpx 38rpx;
  color: #fff;
  background: linear-gradient(90deg, #2459ff 0%, #52b7ff 50%, #b6a6ff 100%);
}

.header-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  opacity: 0.72;
}

.header-title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.header-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.section-label {
  margin: 28rpx 32rpx 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(11, 22, 51, 0.45);
  letter-spacing: 2rpx;
}

.task-card,
.class-card {
  position: relative;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1px solid rgba(11, 22, 51, 0.06);
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.task-card::before {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 4px;
  border-radius: 0 0 4px 4px;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%);
}

.task-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 12px;
  padding: 4px 12px 4px 10px;
  border-radius: 999px;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: none;
}

.badge::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

.badge.practice {
  color: #2459ff;
  background: rgba(36, 89, 255, 0.12);
}

.badge.hw {
  color: #d97706;
  background: rgba(217, 119, 6, 0.14);
}

.task-title,
.class-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #0b1633;
}

.task-meta,
.class-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.5);
}

.task-action {
  margin-top: 14rpx;
  color: #2459ff;
  font-size: 24rpx;
  font-weight: 700;
}

.class-code {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  color: #2459ff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.class-code.pending {
  color: #d97706;
}

.empty,
.loading {
  padding: 90rpx 0;
  text-align: center;
  color: rgba(11, 22, 51, 0.48);
  font-size: 25rpx;
}

.empty text {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(11, 22, 51, 0.35);
}
