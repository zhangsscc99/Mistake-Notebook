<view class="teacher-shell set-detail">
  <view class="teacher-hero">
    <view class="hero-kicker">{{kindLabel}}</view>
    <view class="hero-title">{{title}}</view>
    <view class="hero-sub">{{meta}}</view>
  </view>

  <view class="loading-line" wx:if="{{loading}}">加载题目…</view>

  <view class="white-card" wx:for="{{questions}}" wx:key="id">
    <view class="q-index">第 {{item.index}} 题</view>
    <view class="q-content">{{item.content}}</view>
    <view class="q-meta" wx:if="{{item.category || item.nickName}}">
      <text class="badge" wx:if="{{item.category}}">{{item.category}}</text>
      <text class="badge" wx:if="{{item.nickName}}">{{item.nickName}}</text>
    </view>
  </view>
  <view class="empty-block" wx:if="{{!loading && !questions.length}}">这份试卷里没有可显示的题目<text>题目可能已被删除</text></view>

  <view class="submit-wrap" wx:if="{{!loading && type === 'paper'}}">
    <button class="primary-btn" wx:if="{{questions.length}}" bindtap="sendToClass">发给班级</button>
    <button class="ghost-btn" wx:if="{{questions.length}}" bindtap="addMore">继续加题</button>
    <button class="ghost-btn" wx:if="{{questions.length}}" bindtap="exportPdf">导出 PDF</button>
    <button class="danger-btn" bindtap="recall">删除试卷</button>
  </view>
  <view class="submit-wrap" wx:if="{{!loading && type !== 'paper'}}">
    <button class="danger-btn" bindtap="recall">撤回练习</button>
  </view>
</view>
