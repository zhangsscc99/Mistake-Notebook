.teacher-shell.picking {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.search-box {
  display: flex;
  align-items: center;
  margin: 8rpx 24rpx 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 999px;
  border: 1px solid rgba(11, 22, 51, 0.06);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-clear {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #2459ff;
  font-size: 22rpx;
  font-weight: 700;
}

.chip-scroll {
  white-space: nowrap;
  width: 100%;
  padding: 0 24rpx 12rpx;
  box-sizing: border-box;
}

.chip-scroll .chip {
  display: inline-flex;
  margin-right: 12rpx;
  vertical-align: middle;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 24rpx 8rpx;
}

.q-content {
  font-size: 26rpx;
  color: #0b1633;
  line-height: 1.55;
}

.q-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.hot-count {
  font-size: 22rpx;
  color: #2459ff;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(36, 89, 255, 0.35);
  text-align: center;
  line-height: 36rpx;
  color: #fff;
  font-size: 22rpx;
  flex-shrink: 0;
}

.check.on {
  background: linear-gradient(135deg, #2459ff, #52b7ff);
  border-color: transparent;
}

.pick-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 40;
  padding: 16rpx 24rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(11, 22, 51, 0.06);
}

.pick-dock-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0b1633;
}

.pick-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pick-actions .ghost-btn,
.pick-actions .primary-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 0 28rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 999px;
  border: 1px solid rgba(11, 22, 51, 0.06);
}

.picker-kicker {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(11, 22, 51, 0.5);
}

.picker-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #2459ff;
  white-space: nowrap;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(11, 22, 51, 0.36);
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  padding: 28rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-title {
  padding: 0 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #0b1633;
}

.sheet-search {
  margin-top: 8rpx;
}

.sheet-list {
  height: 52vh;
  padding: 8rpx 0;
}

.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0b1633;
}

.sheet-row.on {
  color: #2459ff;
  background: rgba(36, 89, 255, 0.08);
}

.sheet-count {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(11, 22, 51, 0.45);
  white-space: nowrap;
}

.sheet-empty {
  padding: 48rpx 32rpx;
  text-align: center;
  color: rgba(11, 22, 51, 0.45);
  font-size: 24rpx;
}
