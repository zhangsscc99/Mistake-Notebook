<view class="teacher-shell create-page">
  <view class="teacher-hero">
    <view class="hero-kicker">SEND</view>
    <view class="hero-title">发给班级</view>
    <view class="hero-sub">题目已在组卷页选好。这里只选发给班级的方式：练习看题，作业作答批改</view>
  </view>

  <view class="section-head"><text class="section-title">发给班级的方式</text></view>
  <view class="chip-row">
    <view class="chip {{kind === 'practice' ? 'on' : ''}}" data-kind="practice" bindtap="setKind">练习</view>
    <view class="chip {{kind === 'homework' ? 'on' : ''}}" data-kind="homework" bindtap="setKind">作业</view>
  </view>
  <view class="hint" wx:if="{{kind === 'practice'}}">学生在「我的班级」查看题目，不用提交</view>
  <view class="hint" wx:if="{{kind === 'homework'}}">学生需要作答提交，老师可在作业页打分</view>

  <view class="section-head"><text class="section-title">班级</text></view>
  <view class="chip-row">
    <view class="chip {{selectedClass.id === item.id ? 'on' : ''}}" wx:for="{{classes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view>
  </view>
  <view class="empty-block" wx:if="{{!classes.length}}">还没有班级<text>先去「班级」新建</text></view>

  <view class="section-head"><text class="section-title">名称</text></view>
  <view class="white-card">
    <input class="field" value="{{title}}" placeholder="{{kind === 'homework' ? '例如：周五作业' : '例如：周五练习'}}" maxlength="30" bindinput="onTitle" />
  </view>

  <block wx:if="{{kind === 'homework'}}">
    <view class="section-head"><text class="section-title">截止时间</text></view>
    <view class="white-card row-card">
      <picker mode="date" value="{{dueDate}}" bindchange="onDue">
        <view class="field">{{dueDate || '可选，不设则不限制'}}</view>
      </picker>
      <text class="clear" wx:if="{{dueDate}}" catchtap="clearDue">清除</text>
    </view>
  </block>

  <view class="section-head"><text class="section-title">本次题目</text><text class="section-note" wx:if="{{pickCount}}">{{pickCount}} 道</text></view>
  <view class="white-card" wx:for="{{cart}}" wx:key="id">
    <view class="paper-title">{{item.index}}. {{item.content}}</view>
    <view class="paper-meta">{{item.sourceLabel}} · {{item.category}}</view>
  </view>
  <view class="empty-block" wx:if="{{!pickCount}}">还没有组卷选题<text class="link" bindtap="goPick">去题目页勾选，再带到组卷</text></view>

  <view class="submit-wrap" wx:if="{{pickCount}}">
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">发给班级</button>
  </view>
</view>
