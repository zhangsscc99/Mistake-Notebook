/* pages/variants/variants.wxss */
.variants-page {
  min-height: 100vh;
  padding: 16px 16px calc(100px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: #eef3fb;
  background-image:
    radial-gradient(circle 420rpx at 100% 0%, rgba(82, 183, 255, 0.12) 0%, transparent 60%),
    radial-gradient(circle 360rpx at 0% 4%, rgba(182, 166, 255, 0.10) 0%, transparent 55%),
    linear-gradient(rgba(11, 22, 51, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(11, 22, 51, 0.025) 1px, transparent 1px);
  background-size: auto, auto, 44rpx 44rpx, 44rpx 44rpx;
}

.state-card {
  margin-top: 80px;
  background: #ffffff;
  border: 1px solid rgba(11, 22, 51, 0.06);
  border-radius: 22px;
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.state-spinner {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 3px solid rgba(36, 89, 255, 0.15);
  border-top-color: #2459ff;
  animation: v-spin 0.9s linear infinite;
  margin-bottom: 18px;
}

@keyframes v-spin {
  to { transform: rotate(360deg); }
}

.state-title {
  display: block;
  width: 100%;
  font-size: 16px;
  font-weight: 700;
  color: #0b1633;
  margin-bottom: 8px;
  text-align: center;
}

.state-sub {
  display: block;
  width: 100%;
  font-size: 13px;
  color: rgba(11, 22, 51, 0.50);
  text-align: center;
  line-height: 1.6;
}

.state-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 40rpx auto 0 !important;
  width: 360rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  padding: 0 !important;
  line-height: 1 !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 999px !important;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%) !important;
  color: #ffffff !important;
  border: none !important;
  box-sizing: border-box !important;
  text-align: center !important;
  box-shadow: 0 10px 24px rgba(31, 91, 255, 0.30) !important;
}

.state-btn::after {
  border: none !important;
}

.hint-card {
  background: #ffffff;
  border: 1px solid rgba(11, 22, 51, 0.06);
  border-radius: 18px;
  padding: 16px 18px;
  margin-bottom: 14px;
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
}

.hint-title {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #0b1633;
  margin-bottom: 4px;
}

.hint-sub {
  font-size: 13px;
  color: rgba(11, 22, 51, 0.50);
}

.variant-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: #ffffff;
  border: 1px solid rgba(11, 22, 51, 0.06);
  border-radius: 18px;
  padding: 22px 16px 16px;
  margin-bottom: 14px;
  box-shadow: 0 12px 36px rgba(11, 22, 51, 0.06);
  overflow: visible;
}

.variant-card.selected {
  border-color: rgba(36, 89, 255, 0.45);
  box-shadow:
    0 0 0 2px rgba(36, 89, 255, 0.18),
    0 12px 36px rgba(31, 91, 255, 0.12);
}

.v-index-tag {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  border-radius: 12rpx 4rpx 12rpx 4rpx;
  background: linear-gradient(140deg, #2459ff, #52b7ff);
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(31, 91, 255, 0.32);
  z-index: 3;
}

.v-select {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  border: 2px solid rgba(36, 89, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-sizing: border-box;
  flex-shrink: 0;
  margin-top: 2px;
  margin-left: 6px;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
}

.v-select.checked {
  background: #2459ff;
  border-color: #2459ff;
}

.v-body {
  flex: 1;
  min-width: 0;
}

.v-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 12px;
  padding: 4px 12px 4px 10px;
  border-radius: 999px;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
  border: none;
}

.badge::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

.badge-easy {
  color: #15a34a;
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.16), rgba(34, 197, 94, 0.08));
}

.badge-medium {
  color: #c2680a;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(245, 158, 11, 0.08));
}

.badge-hard {
  color: #e11d48;
  background: linear-gradient(135deg, rgba(244, 63, 94, 0.18), rgba(244, 63, 94, 0.08));
}

.v-kp {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 6px;
  background: rgba(36, 89, 255, 0.08);
  color: #2459ff;
  border: 1px solid rgba(36, 89, 255, 0.12);
}

.v-content {
  display: block;
  font-size: 15px;
  color: #1a2440;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 10px;
}

.v-answer-toggle {
  font-size: 13px;
  font-weight: 600;
  color: #2459ff;
  padding: 4px 0;
}

.v-answer-box {
  margin-top: 8px;
  background: linear-gradient(135deg, rgba(31, 91, 255, 0.04), rgba(82, 183, 255, 0.02));
  border: 1px solid rgba(31, 91, 255, 0.12);
  border-left: 4px solid #2459ff;
  padding: 12px;
  border-radius: 10px;
}

.v-answer-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #2459ff;
  margin-bottom: 4px;
}

.v-answer-text {
  display: block;
  font-size: 13px;
  color: rgba(11, 22, 51, 0.72);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 10px;
}

.v-answer-text:last-child {
  margin-bottom: 0;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid rgba(47, 107, 255, 0.14);
  box-shadow: 0 -8px 24px rgba(11, 22, 51, 0.08);
  z-index: 100;
}

.save-info {
  font-size: 14px;
  font-weight: 600;
  color: #0b1633;
  flex-shrink: 0;
}

.save-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex: 1;
  margin: 0 !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  padding: 0 !important;
  line-height: 1 !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  border-radius: 14px !important;
  background: linear-gradient(135deg, #2459ff 0%, #52b7ff 100%) !important;
  color: #ffffff !important;
  border: none !important;
  box-sizing: border-box !important;
  text-align: center !important;
  box-shadow: 0 10px 24px rgba(31, 91, 255, 0.30) !important;
}

.save-btn::after {
  border: none !important;
}

.save-btn[disabled] {
  opacity: 0.45;
  box-shadow: none !important;
}
